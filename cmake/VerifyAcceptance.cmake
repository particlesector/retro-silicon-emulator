if(NOT DEFINED GENERATOR OR NOT DEFINED OUTPUT)
  message(FATAL_ERROR "GENERATOR and OUTPUT are required")
endif()
execute_process(COMMAND "${GENERATOR}" --write-set "${OUTPUT}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Acceptance fixture generation failed: ${result}")
endif()
set(root "${CMAKE_CURRENT_LIST_DIR}/..")
file(READ "${root}/tests/acceptance/manifest.json" manifest)
execute_process(COMMAND "${GENERATOR}" --print-baseline RESULT_VARIABLE result OUTPUT_VARIABLE observed)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Acceptance observation capture failed: ${result}")
endif()
file(WRITE "${OUTPUT}/observations.txt" "${observed}")
string(JSON count LENGTH "${manifest}" programs)
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
  string(JSON name GET "${manifest}" programs ${index} filename)
  string(JSON expected GET "${manifest}" programs ${index} sha256)
  string(JSON bytes GET "${manifest}" programs ${index} bytes)
  file(SHA256 "${OUTPUT}/${name}" actual)
  file(SIZE "${OUTPUT}/${name}" size)
  if(NOT actual STREQUAL expected OR NOT size EQUAL bytes)
    message(FATAL_ERROR "Frozen fixture ${name} changed: ${actual} (${size} bytes)")
  endif()
  message(STATUS "Verified ${name}: ${actual}")
  string(JSON expected ERROR_VARIABLE status GET "${manifest}" programs ${index} expected)
  if(status STREQUAL "NOTFOUND")
    set(line "${name}")
    foreach(field tick samples state events frames pcm)
      string(JSON value GET "${expected}" ${field})
      string(APPEND line " ${field}=${value}")
    endforeach()
    string(FIND "${observed}" "${line}" position)
    if(position EQUAL -1)
      message(FATAL_ERROR "Recorded observation mismatch: ${line}")
    endif()
  endif()
endforeach()
file(COPY "${root}/tests/acceptance/manifest.json" "${root}/LICENSE"
  "${root}/tests/acceptance_programs.hpp" "${root}/tests/nes_programs.hpp"
  DESTINATION "${OUTPUT}")
