{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RSE_BUILD_TESTS": "ON",
        "RSE_BUILD_DESKTOP": "OFF"
      }
    }
